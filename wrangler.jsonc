{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "portfolio-sinthiafabianagonzalez",
  "compatibility_date": "2025-11-01",
  "compatibility_flags": ["nodejs_compat"],
  // Worker propio: atiende /api/* (formulario de contacto) y el resto lo sirve la web estática
  "main": "./worker/index.ts",
  "assets": {
    // Astro genera la web estática en dist/ con `npm run build`
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  // Envío de emails con Cloudflare Email Routing (solo a la dirección verificada de Sinthia)
  "send_email": [
    { "name": "SEND_EMAIL", "destination_address": "gonzalez.sinthia@icloud.com" }
  ],
  // Máximo 3 mensajes por minuto y visitante
  "ratelimits": [
    { "name": "LIMITE_CONTACTO", "namespace_id": "1001", "simple": { "limit": 3, "period": 60 } }
  ]
}
