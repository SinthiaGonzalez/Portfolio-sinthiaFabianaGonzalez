---
import Layout from '../layouts/Layout.astro';
import FloatingAvatar from '../components/FloatingAvatar.tsx';
import avatar from '../assets/avatar.png';

// Página temporal: se sustituirá por el portfolio completo del diseño de Figma.
const links = [
  { label: 'Serena Hotel', href: 'https://serena.sinthiagonzalez.com', primary: true, icon: 'hotel' },
  { label: 'GitHub', href: 'https://github.com/SinthiaGonzalez', icon: 'github' },
  { label: 'LinkedIn', href: 'https://linkedin.com/in/sinthiagonzalez', icon: 'linkedin' },
] as const;
---

<Layout description="Portfolio de Sinthia Fabiana González, desarrolladora web full stack junior. Próximamente.">
  <main class="relative mx-auto grid min-h-screen max-w-[1100px] items-center gap-5 px-6 pt-9 pb-12 text-center md:grid-cols-[1.1fr_0.9fr] md:gap-10 md:pt-12 md:text-left">
    <div aria-hidden="true" class="pointer-events-none absolute inset-0 overflow-hidden md:overflow-visible">
      <div class="animate-blob absolute top-[170px] right-1/2 size-[300px] translate-x-1/2 bg-sand md:top-1/2 md:right-[-60px] md:size-[420px] md:translate-x-0 md:-translate-y-1/2"></div>
      <div class="animate-float absolute top-[10%] left-[4%] size-[120px] rounded-full bg-terra opacity-[0.18]"></div>
      <div class="animate-float absolute bottom-[8%] left-[44%] size-[70px] rounded-full bg-olive opacity-20 [animation-direction:alternate-reverse] [animation-duration:9s]"></div>
    </div>

    <div class="relative z-10">
      <span class="mb-5 inline-block rounded-full border border-line bg-card px-3.5 py-1.5 text-[13px] font-bold tracking-[1.2px] text-terra uppercase">
        🌿 Portfolio en construcción
      </span>
      <h1 class="font-serif text-[clamp(40px,6vw,66px)] leading-[1.02] text-olive-button">
        Sinthia Fabiana González
      </h1>
      <p class="mt-3 mb-5 text-[clamp(18px,2.2vw,22px)] font-medium text-terra">
        Desarrolladora Web Full Stack Junior
      </p>
      <p class="mx-auto max-w-[520px] text-[17px] leading-relaxed text-muted md:mx-0">
        Estoy preparando mi portfolio con mis proyectos y experiencia. Mientras tanto, puedes ver mi trabajo y contactarme aquí:
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-3 md:justify-start">
        {links.map((link) => (
          <a
            href={link.href}
            target="_blank"
            rel="noopener"
            class:list={[
              'inline-flex items-center gap-2 rounded-xl border px-5 py-3 text-[15px] font-bold transition hover:-translate-y-0.5',
              'primary' in link
                ? 'border-olive-button bg-olive-button text-white hover:bg-olive-dark'
                : 'border-line bg-card text-olive-button hover:bg-white',
            ]}
          >
            {link.icon === 'hotel' && (
              <svg class="size-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 21h18M5 21V7l7-4 7 4v14M9 21v-6h6v6" /></svg>
            )}
            {link.icon === 'github' && (
              <svg class="size-[18px]" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .5a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.52-1.33-1.28-1.69-1.28-1.69-1.05-.71.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.84 1.19 3.1 0 4.42-2.7 5.4-5.26 5.68.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5Z" /></svg>
            )}
            {link.icon === 'linkedin' && (
              <svg class="size-[18px]" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28ZM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13ZM7.12 20.45H3.56V9h3.56v11.45ZM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0Z" /></svg>
            )}
            {link.label}
          </a>
        ))}
      </div>
    </div>

    <div class="relative z-10 order-first flex justify-center md:order-none">
      <FloatingAvatar client:load src={avatar.src} width={avatar.width} height={avatar.height} alt="Ilustración de Sinthia González" />
    </div>
  </main>

  <footer class="relative z-10 px-6 pb-7 text-center text-[13px] text-muted md:-mt-10">
    Boiro, A Coruña · © 2026 Sinthia Fabiana González
  </footer>
</Layout>
