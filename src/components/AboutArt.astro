---
import { useContent } from '../i18n';
const { ui } = useContent(Astro.currentLocale);
// Ilustración de "Sobre mí" (exportada del diseño).
import avatar from '../assets/avatar-about.png';
import Maple from '../assets/deco/piezas/hoja-maple.svg';
import Falling from '../assets/deco/piezas/hoja-falling.svg';
import Fallen from '../assets/deco/piezas/hoja-fallen.svg';
import Guirnalda from '../assets/deco/piezas/guirnalda-avatar.svg';
---

<svg data-fall-area class="h-auto w-full overflow-visible" role="img" aria-label={ui.aboutArt} width="480" height="570" viewBox="0 0 480 570" xmlns="http://www.w3.org/2000/svg">
 <defs>
  <!-- El avatar va dentro del círculo de fondo: la cabeza sobresale por arriba y el cuerpo
       termina con la curva del círculo (centro 245,335 · radio 215, amplio para que se vean
       las manos y el portátil) -->
  <clipPath id="about-avatar-clip"><path d="M0 0 H480 V335 H460 A215 215 0 0 1 30 335 H0 Z"/></clipPath>
 </defs>
 <!-- Círculo de fondo: el mismo círculo en el que encaja el avatar -->
 <circle cx="245" cy="335" r="215" fill="#E3CBB3"/>
 <path data-about-blob d="M118 92 C170 58 248 70 276 118 C302 162 276 214 226 232 C170 252 104 236 82 190 C62 148 76 118 118 92Z" fill="#EDE2D2"/>
 <path data-about-blob d="M360 120 C392 104 430 118 440 150 C450 182 428 206 398 208 C366 210 344 188 344 160 C344 142 348 128 360 120Z" fill="#E9DACA"/>
 <g transform="translate(-38 40)"><path data-about-blob d="M40 400 C70 360 140 368 168 410 C196 452 170 512 118 524 C66 536 22 500 18 458 C16 432 24 414 40 400Z" fill="#D9B99A"/></g>
 <circle data-about-dot cx="352" cy="96" r="6" fill="#B47A57" opacity="1"/><circle data-about-dot cx="378" cy="232" r="9" fill="#B47A57" opacity="0.85"/><circle data-about-dot cx="400" cy="262" r="5" fill="#B47A57" opacity="1"/><circle data-about-dot cx="366" cy="284" r="4" fill="#B47A57" opacity="0.8"/><circle data-about-dot cx="30" cy="330" r="5" fill="#B47A57" opacity="0.9"/><circle data-about-dot cx="56" cy="300" r="3.5" fill="#B47A57" opacity="0.8"/><circle data-about-dot cx="458" cy="420" r="4" fill="#B47A57" opacity="0.8"/><circle data-about-dot cx="438" cy="330" r="4" fill="#B47A57" opacity="0.7"/>
 
 <!-- Hojas que caen POR DETRÁS del avatar: nacen escondidas tras él, se ven al pasar por los lados
      y reaparecen bajo el círculo; al llegar abajo se desvanecen y vuelven a caer -->
 <g data-deco="fall" style="transform-box:fill-box;transform-origin:center"><Maple x="170" y="120" width="30" height="30" class="overflow-visible" aria-hidden="true" /></g>
 <g data-deco="fall" style="transform-box:fill-box;transform-origin:center"><Falling x="298" y="105" width="28" height="27" class="overflow-visible" aria-hidden="true" /></g>
 <g data-deco="fall" style="transform-box:fill-box;transform-origin:center"><Fallen x="70" y="225" width="26" height="26" class="overflow-visible" aria-hidden="true" /></g>
 <g data-deco="fall" style="transform-box:fill-box;transform-origin:center"><Maple x="228" y="85" width="24" height="24" class="overflow-visible" aria-hidden="true" /></g>
 <g data-deco="fall" style="transform-box:fill-box;transform-origin:center"><Fallen x="318" y="190" width="22" height="22" class="overflow-visible" aria-hidden="true" /></g>
 <g data-deco="fall" style="transform-box:fill-box;transform-origin:center"><Falling x="405" y="170" width="26" height="26" class="overflow-visible" aria-hidden="true" /></g>
 <g data-deco="fall" style="transform-box:fill-box;transform-origin:center"><Maple x="118" y="300" width="22" height="22" class="overflow-visible" aria-hidden="true" /></g>
 <g data-deco="fall" style="transform-box:fill-box;transform-origin:center"><Falling x="200" y="230" width="20" height="20" class="overflow-visible" aria-hidden="true" /></g>
 <g clip-path="url(#about-avatar-clip)"><image href={avatar.src} x="20" y="5" width="440" height="589" preserveAspectRatio="xMidYMin meet"/></g>
 <!-- Guirnalda bajo el avatar: el centro del arco queda justo debajo del círculo y los
      extremos suben por los lados, como un marco. Se balancea muy poco desde el centro (data-sway="0.6" = 0,6°). -->
 <g data-deco="sway" data-sway="0.6" style="transform-origin:252px 561px;transform-box:view-box">
  <Guirnalda x="-10.4" y="350" width="525" height="270.6" class="overflow-visible" aria-hidden="true" />
 </g>
 
</svg>
