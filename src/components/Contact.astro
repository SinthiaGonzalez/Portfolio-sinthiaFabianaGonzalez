---
import { contact, site } from '../data/content';
import SectionTitle from './SectionTitle.astro';
import Decor from './Decor.astro';
import Icon from './Icon.astro';
import Deco from './Deco.astro';

const field =
  'w-full rounded-[14px] border border-[#ddd3c2] bg-cream px-5 text-[15px] text-ink placeholder:text-[#9a948a] focus:border-olive focus:ring-2 focus:ring-olive/20 focus:outline-none';
---

<section id="contacto" data-fall-area class="relative bg-cream px-6 py-16 md:px-10 md:py-20 lg:px-[120px] lg:py-[100px]">
  <Decor morph blobs={{ left: { color: '#B47A57', top: '18%' }, right: { color: '#5D6C52', top: '55%' } }} />
  <!-- Lluvia de hojas por la sección, por detrás del formulario -->
  <Deco pieza="maple" cae class="top-6 left-[5%] z-[1] w-[22px] md:w-[30px]" />
  <Deco pieza="falling" cae class="top-24 left-[22%] z-[1] w-[20px] md:w-[26px]" />
  <Deco pieza="fallen" cae class="top-4 left-[48%] z-[1] w-[20px] md:w-[26px]" />
  <Deco pieza="maple" cae class="top-20 right-[24%] z-[1] w-[20px] md:w-[26px]" />
  <Deco pieza="falling" cae class="top-8 right-[6%] z-[1] w-[22px] md:w-[28px]" />
  <!-- Rama terracota que entra desde el borde derecho de la pantalla (volteada: el tallo
       apunta al borde y su base queda fuera de la vista) -->
  <Deco pieza="terracota" flip class="top-[52%] -right-[27px] z-[1] w-[80px] md:-right-[30px] md:w-[110px] lg:-right-[34px] lg:w-[160px]" />
  <SectionTitle title={contact.title} />

  <div class="relative z-[2] mx-auto w-full max-w-[760px]">
    <!-- Ramas que nacen DETRÁS del formulario: la base del tallo queda bajo la tarjeta
         y las hojas salen hacia fuera (olivos en las dos esquinas de arriba) -->
    <Deco pieza="olivo" id="rama-contacto-olivo" class="-top-[71px] -left-[33px] z-[1] w-[70px] md:-top-[197px] md:-left-[105px] md:w-[150px]" />
    <Deco pieza="olivo" id="rama-contacto-olivo-der" flip class="-top-[71px] -right-[33px] z-[1] w-[70px] md:-top-[197px] md:-right-[105px] md:w-[150px]" />

    <form id="contact-form" class="relative z-[2] flex flex-col gap-4 rounded-3xl border border-line bg-card px-5 py-7 md:px-14 md:py-12" novalidate>
      <p class="mb-2.5 text-center text-[15px] leading-relaxed text-muted md:text-lg">{contact.intro}</p>
      <label class="sr-only" for="cf-name">{contact.fields.name}</label>
      <input id="cf-name" name="name" required autocomplete="name" placeholder={contact.fields.name} class={`${field} h-[54px]`} />
      <label class="sr-only" for="cf-email">{contact.fields.email}</label>
      <input id="cf-email" name="email" type="email" required autocomplete="email" placeholder={contact.fields.email} class={`${field} h-[54px]`} />
      <label class="sr-only" for="cf-subject">{contact.fields.subject}</label>
      <input id="cf-subject" name="subject" placeholder={contact.fields.subject} class={`${field} h-[54px]`} />
      <label class="sr-only" for="cf-message">{contact.fields.message}</label>
      <textarea id="cf-message" name="message" required rows="5" placeholder={contact.fields.message} class={`${field} h-[150px] resize-y py-4`}></textarea>
      <p id="cf-error" class="hidden text-center text-sm text-terra" role="alert"></p>
      <div class="mt-2 flex justify-center">
        <button type="submit" class="inline-flex h-[46px] items-center justify-center rounded-full bg-olive px-14 text-[15px] font-medium text-white transition hover:bg-olive-dark md:h-[50px] md:text-base">
          {contact.send}
        </button>
      </div>
    </form>
  </div>

  <div class="relative z-[2] mt-7 flex flex-col items-center gap-3 text-[15px] text-muted md:flex-row md:justify-center md:gap-7">
    <a href={`mailto:${site.email}`} class="flex items-center gap-2 hover:text-olive-dark"><Icon name="mail" size={16} class="text-olive-dark" /> {site.email}</a>
    <span class="flex items-center gap-2"><Icon name="pin" size={16} class="text-olive-dark" /> {site.location}</span>
  </div>
</section>

<script define:vars={{ email: site.email }}>
  // De momento el formulario abre el correo del visitante con el mensaje ya escrito.
  // TODO: sustituir por un envío real (Worker de Cloudflare + Resend).
  const form = document.getElementById('contact-form');
  const error = document.getElementById('cf-error');
  form.addEventListener('submit', (e) => {
    e.preventDefault();
    const data = new FormData(form);
    if (!form.checkValidity()) {
      error.textContent = 'Rellena tu nombre, un e-mail válido y el mensaje.';
      error.classList.remove('hidden');
      return;
    }
    error.classList.add('hidden');
    const subject = data.get('subject') || `Contacto desde el portfolio: ${data.get('name')}`;
    const body = `${data.get('message')}\n\n— ${data.get('name')} (${data.get('email')})`;
    window.location.href = `mailto:${email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
  });
</script>
