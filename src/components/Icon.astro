const stroked = new Set(['download', 'chevron-up']);

interface Props {
  name: keyof typeof paths;
  size?: number;
  class?: string;
}

const { name, size = 18, class: className } = Astro.props;
const isStroke = stroked.has(name);
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  aria-hidden="true"
  fill={isStroke ? 'none' : 'currentColor'}
  stroke={isStroke ? 'currentColor' : undefined}
  stroke-width={isStroke ? 2.5 : undefined}
  stroke-linecap="round"
  stroke-linejoin="round"
><path d={paths[name]} /></svg>
