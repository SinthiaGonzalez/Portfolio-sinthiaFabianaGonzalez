---
import { useContent } from '../i18n';
import SectionTitle from './SectionTitle.astro';
import Decor from './Decor.astro';
import Icon from './Icon.astro';
import Deco from './Deco.astro';
import { Image } from 'astro:assets';
import capturaSerena from '../assets/proyectos/serena-hotel.png';
import capturaPortfolio from '../assets/proyectos/portfolio.png';
import capturaEuroproject from '../assets/proyectos/europroject.png';

const { projects, ui } = useContent(Astro.currentLocale);

// Capturas reales de cada proyecto (si no hay, se muestra la maqueta de ventana)
const capturas: Record<string, ImageMetadata> = {
  hotel: capturaSerena,
  europroject: capturaEuroproject,
  portfolio: capturaPortfolio,
};

const shotColors: Record<string, string> = {
  hotel: 'bg-[#cdbba8]',
  sushi: 'bg-[#e3b9a0]',
  europroject: 'bg-[#b9cfc4]',
  portfolio: 'bg-[#c8cfb4]',
};
const btn =
  'inline-flex h-11 flex-1 items-center justify-center gap-2 rounded-full px-4 text-sm font-semibold tracking-[1px] transition';
---

<section id="proyectos" data-fall-area class="relative bg-sand px-6 py-16 md:px-10 md:py-20 lg:px-[120px] lg:py-[100px]">
  <Decor waves morph blobs={{ left: { color: '#D5C3B0', top: '12%' }, right: { color: '#B47A57', top: '48%' } }} />
  <Deco pieza="maple" class="top-16 right-[9%] w-[26px] md:w-[34px] lg:top-24 lg:right-[15%] lg:w-[42px]" />
  <!-- Lluvia de hojas por la sección, por detrás de las tarjetas de proyecto -->
  <Deco pieza="falling" cae class="top-8 left-[5%] z-[1] w-[22px] md:w-[28px]" />
  <Deco pieza="fallen" cae class="top-24 left-[23%] z-[1] w-[20px] md:w-[26px]" />
  <Deco pieza="maple" cae class="top-6 left-[47%] z-[1] w-[20px] md:w-[28px]" />
  <Deco pieza="falling" cae class="top-20 right-[25%] z-[1] w-[20px] md:w-[26px]" />
  <Deco pieza="fallen" cae class="top-10 right-[4%] z-[1] w-[22px] md:w-[28px]" />
  <SectionTitle title={projects.title} />

  <ul class="relative z-[2] flex flex-col gap-5 md:gap-7 lg:flex-row">
    {
      projects.items.map((p) => (
        <li class="flex flex-1 flex-col overflow-hidden rounded-2xl border border-line bg-card">
          <div class:list={['relative flex h-[220px] items-center justify-center', shotColors[p.color]]} aria-hidden="true">
            {p.status && (
              <span class:list={['absolute top-4 right-4 rounded-full px-3 py-[5px] text-[11px] font-semibold tracking-[1px] text-white uppercase', p.status === 'live' ? 'bg-olive' : 'bg-terra']}>
                {p.statusLabel}
              </span>
            )}
            <div class="h-40 w-4/5 overflow-hidden rounded-xl bg-[#fbf8f2] shadow-[0_12px_30px_rgba(60,50,30,0.15)]">
              <div class="flex h-[22px] items-center gap-[5px] bg-sand px-2.5">
                <i class="block size-[7px] rounded-full bg-sage" />
                <i class="block size-[7px] rounded-full bg-sage" />
                <i class="block size-[7px] rounded-full bg-sage" />
              </div>
              {capturas[p.color] ? (
                <Image
                  src={capturas[p.color]}
                  alt=""
                  widths={[400, 800]}
                  sizes="(min-width: 1024px) 30vw, 85vw"
                  class="h-[138px] w-full object-cover object-top"
                  loading="lazy"
                />
              ) : (
                <div class="flex flex-col gap-2 p-3.5">
                  <span class="font-serif text-lg">{p.mockTitle ?? p.name}</span>
                  <i class="block h-2 w-[85%] rounded bg-[#ddd3c2]" />
                  <i class="block h-2 w-[60%] rounded bg-[#ddd3c2]" />
                  <span class="mt-1.5 flex gap-2">
                    <i class="block h-11 flex-1 rounded-md bg-sand" />
                    <i class="block h-11 flex-1 rounded-md bg-sand" />
                    <i class="block h-11 flex-1 rounded-md bg-sand" />
                  </span>
                </div>
              )}
            </div>
          </div>

          <div class="flex-1 px-7 pt-[26px] pb-2">
            <h3 class="mb-2.5 font-serif text-2xl lg:text-[28px]">{p.name}</h3>
            <p class="text-[15px] leading-relaxed text-muted">{p.description}</p>
            <ul class="mt-3.5 flex flex-wrap gap-1.5" aria-label={ui.tech}>
              {p.tags.map((tag) => (
                <li class="rounded-full bg-sand px-2.5 py-1 text-xs">{tag}</li>
              ))}
            </ul>
          </div>

          <div class="flex gap-3 px-7 pt-5 pb-7">
            {p.demo ? (
              <a href={p.demo} target="_blank" rel="noopener" class={`${btn} bg-olive-button text-white hover:bg-olive-dark`}>
                <Icon name="eye" size={16} /> DEMO
              </a>
            ) : (
              <span class={`${btn} cursor-default border-[1.5px] border-olive-button text-olive-button opacity-70`}>{ui.soon}</span>
            )}
            {p.repo && (
              <a href={p.repo} target="_blank" rel="noopener" class={`${btn} border-[1.5px] border-olive-button text-olive-button hover:bg-olive-button hover:text-white`}>
                <Icon name="github" /> REPO
              </a>
            )}
          </div>
        </li>
      ))
    }
  </ul>

  <!-- Laurel que cruza hacia Contacto entrando desde el borde izquierdo (tallo fuera de la pantalla) -->
  <Deco pieza="laurel" id="rama-proyectos-laurel" class="-bottom-20 left-[4px] z-[6] w-[60px] rotate-[70deg] md:-bottom-28 md:left-[14px] md:w-[85px] lg:-bottom-36 lg:left-[26px] lg:w-[115px]" />
</section>
