---
import { useContent, homePath, type Lang } from '../i18n';

const { nav, ui } = useContent(Astro.currentLocale);
const lang = ui.lang as Lang;
// Botón ES/EN: enlaces a la portada de cada idioma (el script conserva la sección en la que estás)
const idiomas = (['es', 'en'] as const).map((code) => ({ code, href: homePath(code), active: code === lang }));
---

<header class="relative z-30">
  <nav class="mx-auto flex items-center justify-between px-6 py-[18px] md:px-10 md:py-[22px] lg:px-[120px] lg:py-7" aria-label={ui.navAria}>
    <a href="#inicio" class="flex size-[42px] items-center justify-center rounded-full bg-olive font-serif text-[17px] text-card lg:size-12 lg:text-xl" aria-label={ui.home}>SG</a>

    <div class="hidden items-center gap-6 text-base lg:flex xl:gap-[34px]">
      {
        nav.map((item, i) => (
          <a href={`#${item.id}`} data-nav-link={item.id} class:list={['nav-link border-b-2 pb-1 transition-colors hover:text-olive', i === 0 ? 'is-active' : 'border-transparent']}>
            {item.label}
          </a>
        ))
      }
      <div class="ml-2 flex overflow-hidden rounded-full border-[1.5px] border-olive text-[13px] font-semibold" role="group" aria-label={ui.langAria}>
        {
          idiomas.map((i) => (
            <a href={i.href} hreflang={i.code} lang={i.code} data-lang-link aria-current={i.active ? 'true' : undefined} class:list={['px-[11px] py-[5px] uppercase transition-colors', i.active ? 'bg-olive text-white' : 'text-olive-dark hover:bg-sand']}>
              {i.code}
            </a>
          ))
        }
      </div>
    </div>

    <button id="menu-toggle" type="button" class="flex flex-col gap-[5px] p-2 lg:hidden" aria-expanded="false" aria-controls="mobile-menu" aria-label={ui.openMenu} data-open-label={ui.openMenu} data-close-label={ui.closeMenu}>
      <i class="block h-0.5 w-6 bg-ink transition"></i>
      <i class="block h-0.5 w-6 bg-ink transition"></i>
      <i class="block h-0.5 w-6 bg-ink transition"></i>
    </button>
  </nav>

  <div id="mobile-menu" class="absolute inset-x-4 top-full hidden rounded-2xl border border-line bg-card p-4 shadow-lg lg:hidden">
    <ul class="flex flex-col">
      {
        nav.map((item) => (
          <li>
            <a href={`#${item.id}`} class="block rounded-lg px-4 py-3 text-base hover:bg-sand">{item.label}</a>
          </li>
        ))
      }
    </ul>
    <div class="mt-2 flex justify-center gap-2 border-t border-line pt-3 text-sm font-semibold" role="group" aria-label={ui.langAria}>
      {
        idiomas.map((i) => (
          <a href={i.href} hreflang={i.code} lang={i.code} data-lang-link aria-current={i.active ? 'true' : undefined} class:list={['rounded-full border-[1.5px] border-olive px-4 py-1.5 uppercase', i.active ? 'bg-olive text-white' : 'text-olive-dark']}>
            {i.code}
          </a>
        ))
      }
    </div>
  </div>
</header>

<style>
  .nav-link.is-active {
    color: var(--color-olive);
    font-weight: 600;
    border-color: var(--color-olive);
  }
</style>

<script>
  // Menú móvil
  const toggle = document.getElementById('menu-toggle')!;
  const menu = document.getElementById('mobile-menu')!;
  const setOpen = (open: boolean) => {
    menu.classList.toggle('hidden', !open);
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', (open ? toggle.dataset.closeLabel : toggle.dataset.openLabel) ?? '');
  };
  toggle.addEventListener('click', () => setOpen(menu.classList.contains('hidden')));
  menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));

  // Al cambiar de idioma se mantiene la sección que se está viendo (#experiencia, #proyectos…)
  document.querySelectorAll<HTMLAnchorElement>('[data-lang-link]').forEach((a) =>
    a.addEventListener('click', () => {
      // Sección que ocupa el centro de la pantalla en el momento del clic
      const centro = window.innerHeight / 2;
      const visible = [...document.querySelectorAll<HTMLElement>('main > section[id]')].find((s) => {
        const r = s.getBoundingClientRect();
        return r.top <= centro && r.bottom > centro;
      })?.id;
      if (visible && visible !== 'inicio') a.hash = visible;
    }),
  );

  // Marca en el menú la sección visible
  const links = document.querySelectorAll<HTMLAnchorElement>('[data-nav-link]');
  const observer = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        links.forEach((l) => {
          const active = l.dataset.navLink === entry.target.id;
          l.classList.toggle('is-active', active);
          l.classList.toggle('border-transparent', !active);
        });
      }
    },
    { rootMargin: '-45% 0px -50% 0px' },
  );
  document.querySelectorAll('main > section[id]').forEach((s) => observer.observe(s));
</script>
